<?xml version="1.0" encoding="utf-8" ?>
<!--
  Stand-in for the tray flyout: an acrylic window kept out of the taskbar and Alt+Tab, with a
  More options menu whose Settings item opens the Settings window, as the real flyout will.
-->
<Window
  x:Class="SettingsSpike.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Allot spike launcher">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Stand-in flyout" />
      <Button HorizontalAlignment="Right" AutomationProperties.Name="More options" Content="&#x22EF;">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Quit spike" Click="OnQuitClick" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="4">
      <RadioButtons x:Name="CloseModelChoice" Header="When Settings closes" SelectedIndex="0" SelectionChanged="OnCloseModelChanged">
        <x:String>Destroy the window</x:String>
        <x:String>Hide it and reuse it</x:String>
      </RadioButtons>
      <ToggleSwitch x:Name="ForceForegroundSwitch" Header="Call SetForegroundWindow after Activate" IsOn="True" Toggled="OnForceForegroundToggled" />
      <ToggleSwitch x:Name="HideLauncherSwitch" Header="Hide this launcher when Settings opens (as the flyout closes)" IsOn="True" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Open in 5 s" Click="OnDelayedOpenClick" ToolTipService.ToolTip="Click into another app before it fires" />
      <Button Content="Cycle 20 times" Click="OnCycleClick" />
      <Button Content="GC and count" Click="OnCountClick" />
      <Button Content="Forget position" Click="OnForgetClick" />
    </StackPanel>

    <ScrollViewer Grid.Row="3">
      <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
    </ScrollViewer>

    <TextBlock x:Name="LogPath" Grid.Row="4" FontSize="11" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
  </Grid>
</Window>
