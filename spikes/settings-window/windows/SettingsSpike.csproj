<Project Sdk="Microsoft.NET.Sdk">
  <!--
    M0.2 throwaway spike (Settings roadmap): a second WinUI Window in a Native AOT, unpackaged
    tray-like app. The properties below copy tray/src/Allot.Tray/Allot.Tray.csproj so the answers
    carry over; CI never builds spikes/. M4.1 deletes this folder.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SettingsSpike</RootNamespace>
    <AssemblyName>allot-settings-spike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Program.cs owns Main so a second launch can hand off before any XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
  </ItemGroup>

  <!--
    Publish as the tray does: Native AOT for Release. MSIX tooling stays on, or the publish has
    no .pri with the compiled XAML.
  -->
  <PropertyGroup>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
  </PropertyGroup>
</Project>
