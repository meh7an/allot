<?xml version="1.0" encoding="utf-8" ?>
<!-- "General": the controls the real pages will use, with x:Bind two-way, under AOT. -->
<Page
  x:Class="SettingsSpike.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="General" />
      <TextBox x:Name="FocusProbe" Header="Type here to check keyboard focus" />
      <ToggleSwitch Header="Example switch" IsOn="{x:Bind Example, Mode=TwoWay}" />
      <NumberBox
        Header="Headroom (percent)"
        Minimum="0"
        Maximum="90"
        SpinButtonPlacementMode="Inline"
        Value="{x:Bind Headroom, Mode=TwoWay}" />
      <Slider Header="Same value as a slider" Minimum="0" Maximum="90" Value="{x:Bind Headroom, Mode=TwoWay}" />
      <TextBlock Text="{x:Bind Summary(Example, Headroom), Mode=OneWay}" />
    </StackPanel>
  </ScrollViewer>
</Page>
