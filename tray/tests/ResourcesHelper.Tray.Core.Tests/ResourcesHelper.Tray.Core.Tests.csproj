<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ResourcesHelper.Tray.Core\ResourcesHelper.Tray.Core.csproj" />
  </ItemGroup>

  <!-- The golden UiState fixtures written by the Rust contract tests (rh-shared). -->
  <ItemGroup>
    <None Include="..\..\..\contract\fixtures\*.json" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The app's design tokens, checked against the handoff values by TokenResourceTests, and the
       subset icon fonts, checked to hold every glyph token. -->
  <ItemGroup>
    <None Include="..\..\src\ResourcesHelper.Tray\Themes\Tokens.xaml" Link="Themes\Tokens.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\ResourcesHelper.Tray\Assets\Fonts\*.ttf" LinkBase="Fonts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
