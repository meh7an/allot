<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens from the design handoff ("Design tokens" plus the values its sections
  give), checked against the handoff by TokenResourceTests in the Core tests. Names are
  Allot<Token>Brush. Shadows are not here: DWM draws the flyout's and MenuFlyout its own.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surface: the acrylic tint and the 1 px flyout edge. -->
      <SolidColorBrush x:Key="AllotSurfaceBrush" Color="#DBF3F3F3" />
      <SolidColorBrush x:Key="AllotSurfaceEdgeBrush" Color="#17000000" />

      <!-- Text. -->
      <SolidColorBrush x:Key="AllotTextBrush" Color="#FF1A1A1A" />
      <SolidColorBrush x:Key="AllotTextSecondaryBrush" Color="#FF5C5C5C" />
      <SolidColorBrush x:Key="AllotTextStripBrush" Color="#FF4A4A4A" />
      <SolidColorBrush x:Key="AllotTextSubtleBrush" Color="#FF8A8A8A" />

      <!-- Cards, strips and lines. -->
      <SolidColorBrush x:Key="AllotCardBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="AllotCardBorderBrush" Color="#24000000" />
      <SolidColorBrush x:Key="AllotStripBrush" Color="#13000000" />
      <SolidColorBrush x:Key="AllotSeparatorBrush" Color="#14000000" />
      <SolidColorBrush x:Key="AllotChipBackgroundBrush" Color="#12000000" />
      <SolidColorBrush x:Key="AllotChipForegroundBrush" Color="#FF3A3A3A" />
      <SolidColorBrush x:Key="AllotTileBackgroundBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="AllotQueuedTileBorderBrush" Color="#4D000000" />
      <SolidColorBrush x:Key="AllotTrackBrush" Color="#12000000" />

      <!-- Accent: the system accent, for used fills and toggles that are on. -->
      <SolidColorBrush x:Key="AllotAccentBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="AllotAccentForegroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotAccentBusyBrush" Color="#FF7A9CC4" />

      <!-- States. -->
      <SolidColorBrush x:Key="AllotRunningBrush" Color="#FF0F7B0F" />
      <SolidColorBrush x:Key="AllotWaitingBrush" Color="#FF9D5D00" />
      <SolidColorBrush x:Key="AllotWaitingSoftBrush" Color="#2E9D5D00" />
      <SolidColorBrush x:Key="AllotBenchmarkBrush" Color="#FF6F3FB0" />
      <SolidColorBrush x:Key="AllotBenchmarkForegroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotBenchmarkSoftBrush" Color="#596F3FB0" />
      <SolidColorBrush x:Key="AllotStepUpcomingBrush" Color="#1A000000" />
      <SolidColorBrush x:Key="AllotDangerTextBrush" Color="#FFC42B1C" />
      <SolidColorBrush x:Key="AllotDangerFillBrush" Color="#FFC42B1C" />
      <SolidColorBrush x:Key="AllotDangerFillHoverBrush" Color="#FFA32317" />
      <SolidColorBrush x:Key="AllotDangerForegroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotKillHoverBrush" Color="#24C42B1C" />
      <SolidColorBrush x:Key="AllotStoppedBrush" Color="#FF8A8A8A" />

      <!-- Header buttons and menus. -->
      <SolidColorBrush x:Key="AllotPressedBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="AllotMenuBackgroundBrush" Color="#F7F9F9F9" />
      <SolidColorBrush x:Key="AllotMenuEdgeBrush" Color="#1A000000" />
      <SolidColorBrush x:Key="AllotMenuHoverBrush" Color="#24808080" />
      <SolidColorBrush x:Key="AllotMenuDisabledBrush" Color="#FFA0A0A0" />

      <!-- Resources card. -->
      <SolidColorBrush x:Key="AllotHatchStrongBrush" Color="#33000000" />
      <SolidColorBrush x:Key="AllotHatchWeakBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="AllotMarkerBrush" Color="#FF1A1A1A" />
      <SolidColorBrush x:Key="AllotMarkerRingBrush" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="AllotDriveBrush" Color="#FF6B6B6B" />

      <!-- Service stopped banner. -->
      <SolidColorBrush x:Key="AllotBannerBackgroundBrush" Color="#14C42B1C" />
      <SolidColorBrush x:Key="AllotBannerBorderBrush" Color="#4DC42B1C" />
      <SolidColorBrush x:Key="AllotBannerForegroundBrush" Color="#FF8A1E14" />

      <!-- Tray icon badges. -->
      <SolidColorBrush x:Key="AllotTrayAmberBrush" Color="#FFC27A00" />
      <SolidColorBrush x:Key="AllotTrayRedBrush" Color="#FFC42B1C" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AllotSurfaceBrush" Color="#DB242424" />
      <SolidColorBrush x:Key="AllotSurfaceEdgeBrush" Color="#14FFFFFF" />

      <SolidColorBrush x:Key="AllotTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotTextSecondaryBrush" Color="#FFC5C5C5" />
      <SolidColorBrush x:Key="AllotTextStripBrush" Color="#FFC5C5C5" />
      <SolidColorBrush x:Key="AllotTextSubtleBrush" Color="#FF9A9A9A" />

      <SolidColorBrush x:Key="AllotCardBrush" Color="#0EFFFFFF" />
      <SolidColorBrush x:Key="AllotCardBorderBrush" Color="#66000000" />
      <SolidColorBrush x:Key="AllotStripBrush" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="AllotSeparatorBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="AllotChipBackgroundBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="AllotChipForegroundBrush" Color="#FFDEDEDE" />
      <SolidColorBrush x:Key="AllotTileBackgroundBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="AllotQueuedTileBorderBrush" Color="#4DFFFFFF" />
      <SolidColorBrush x:Key="AllotTrackBrush" Color="#14FFFFFF" />

      <!-- Dark mode uses the accent's light 2 shade, as Windows does. -->
      <SolidColorBrush x:Key="AllotAccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
      <SolidColorBrush x:Key="AllotAccentForegroundBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="AllotAccentBusyBrush" Color="#FF3F7F9E" />

      <SolidColorBrush x:Key="AllotRunningBrush" Color="#FF6CCB5F" />
      <SolidColorBrush x:Key="AllotWaitingBrush" Color="#FFFCE100" />
      <SolidColorBrush x:Key="AllotWaitingSoftBrush" Color="#33FCE100" />
      <SolidColorBrush x:Key="AllotBenchmarkBrush" Color="#FFC9A8F0" />
      <SolidColorBrush x:Key="AllotBenchmarkForegroundBrush" Color="#FF1A1A1A" />
      <SolidColorBrush x:Key="AllotBenchmarkSoftBrush" Color="#59C9A8F0" />
      <SolidColorBrush x:Key="AllotStepUpcomingBrush" Color="#1FFFFFFF" />
      <SolidColorBrush x:Key="AllotDangerTextBrush" Color="#FFFF99A4" />
      <SolidColorBrush x:Key="AllotDangerFillBrush" Color="#FFC42B1C" />
      <SolidColorBrush x:Key="AllotDangerFillHoverBrush" Color="#FFA32317" />
      <SolidColorBrush x:Key="AllotDangerForegroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotKillHoverBrush" Color="#24C42B1C" />
      <SolidColorBrush x:Key="AllotStoppedBrush" Color="#FF8A8A8A" />

      <SolidColorBrush x:Key="AllotPressedBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="AllotMenuBackgroundBrush" Color="#F72C2C2C" />
      <SolidColorBrush x:Key="AllotMenuEdgeBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="AllotMenuHoverBrush" Color="#24808080" />
      <SolidColorBrush x:Key="AllotMenuDisabledBrush" Color="#FF6A6A6A" />

      <SolidColorBrush x:Key="AllotHatchStrongBrush" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="AllotHatchWeakBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="AllotMarkerBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AllotMarkerRingBrush" Color="#99000000" />
      <SolidColorBrush x:Key="AllotDriveBrush" Color="#FFA8A8A8" />

      <SolidColorBrush x:Key="AllotBannerBackgroundBrush" Color="#1AFF99A4" />
      <SolidColorBrush x:Key="AllotBannerBorderBrush" Color="#59FF99A4" />
      <SolidColorBrush x:Key="AllotBannerForegroundBrush" Color="#FFFFB3BB" />

      <SolidColorBrush x:Key="AllotTrayAmberBrush" Color="#FFFCE100" />
      <SolidColorBrush x:Key="AllotTrayRedBrush" Color="#FFFF6B6B" />
    </ResourceDictionary>

    <!-- High contrast maps every token to a system colour. -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="AllotSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotSurfaceEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

      <SolidColorBrush x:Key="AllotTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTextStripBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTextSubtleBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

      <SolidColorBrush x:Key="AllotCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotStripBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotChipBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotChipForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTileBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotQueuedTileBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

      <SolidColorBrush x:Key="AllotAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="AllotAccentBusyBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

      <SolidColorBrush x:Key="AllotRunningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotWaitingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotWaitingSoftBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AllotBenchmarkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotBenchmarkForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <!-- Completed steps in full ink, so they differ from upcoming ones (GrayText). -->
      <SolidColorBrush x:Key="AllotBenchmarkSoftBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotStepUpcomingBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AllotDangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotDangerFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotDangerFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotDangerForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="AllotKillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotStoppedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

      <SolidColorBrush x:Key="AllotPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotMenuBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotMenuEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotMenuHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AllotMenuDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

      <SolidColorBrush x:Key="AllotHatchStrongBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AllotHatchWeakBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotMarkerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotMarkerRingBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotDriveBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

      <SolidColorBrush x:Key="AllotBannerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="AllotBannerBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotBannerForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

      <SolidColorBrush x:Key="AllotTrayAmberBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="AllotTrayRedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Fonts. The icon fonts are Fluent System Icons (MIT, microsoft/fluentui-system-icons). -->
  <FontFamily x:Key="AllotTextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="AllotDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="AllotMonoFontFamily">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="AllotIconRegularFontFamily">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
  <FontFamily x:Key="AllotIconFilledFontFamily">ms-appx:///Assets/Fonts/FluentSystemIcons-Filled.ttf#FluentSystemIcons-Filled</FontFamily>

  <!--
    Glyphs, by Fluent System Icons name. *Regular ones are in AllotIconRegularFontFamily, *Filled in
    AllotIconFilledFontFamily. Codepoints from the fonts' JSON maps at commit 463d58b.
  -->
  <x:String x:Key="AllotGlyphLockOpenRegular">&#xE795;</x:String>
  <x:String x:Key="AllotGlyphLockClosedFilled">&#xE79D;</x:String>
  <x:String x:Key="AllotGlyphPinRegular">&#xF601;</x:String>
  <x:String x:Key="AllotGlyphPinFilled">&#xF60B;</x:String>
  <x:String x:Key="AllotGlyphMoreHorizontalRegular">&#xE824;</x:String>
  <x:String x:Key="AllotGlyphDismissCircleRegular">&#xF36D;</x:String>
  <x:String x:Key="AllotGlyphDismissCircleFilled">&#xF36D;</x:String>
  <x:String x:Key="AllotGlyphPlayCircleFilled">&#xE9A6;</x:String>
  <x:String x:Key="AllotGlyphClockRegular">&#xF2DD;</x:String>
  <x:String x:Key="AllotGlyphTimerRegular">&#xED88;</x:String>
  <x:String x:Key="AllotGlyphCheckmarkCircleFilled">&#xF298;</x:String>
  <x:String x:Key="AllotGlyphErrorCircleFilled">&#xF3F0;</x:String>
  <x:String x:Key="AllotGlyphChevronUpRegular">&#xF2B6;</x:String>
  <x:String x:Key="AllotGlyphChevronDownRegular">&#xF2A3;</x:String>
  <x:String x:Key="AllotGlyphChevronRightRegular">&#xF2B0;</x:String>
  <x:String x:Key="AllotGlyphDataBarHorizontalRegular">&#xF39B;</x:String>
  <x:String x:Key="AllotGlyphAlertRegular">&#xF114;</x:String>
  <x:String x:Key="AllotGlyphDocumentTextRegular">&#xE557;</x:String>
  <x:String x:Key="AllotGlyphOpenRegular">&#xF582;</x:String>
  <x:String x:Key="AllotGlyphCheckmarkRegular">&#xF294;</x:String>
  <x:String x:Key="AllotGlyphStopRegular">&#xF72A;</x:String>

  <!-- Radii. -->
  <CornerRadius x:Key="AllotFlyoutCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="AllotCardCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="AllotControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="AllotChipCornerRadius">9</CornerRadius>
  <CornerRadius x:Key="AllotBarCornerRadius">2</CornerRadius>

  <!-- Spacing scale. -->
  <x:Double x:Key="AllotSpacing2">2</x:Double>
  <x:Double x:Key="AllotSpacing4">4</x:Double>
  <x:Double x:Key="AllotSpacing6">6</x:Double>
  <x:Double x:Key="AllotSpacing8">8</x:Double>
  <x:Double x:Key="AllotSpacing10">10</x:Double>
  <x:Double x:Key="AllotSpacing12">12</x:Double>
  <x:Double x:Key="AllotSpacing14">14</x:Double>
  <x:Double x:Key="AllotSpacing16">16</x:Double>
  <x:Double x:Key="AllotDetailInset">28</x:Double>

  <!-- Sizes and paddings from the handoff sections (XAML order: left, top, right, bottom). -->
  <x:Double x:Key="AllotFlyoutWidth">360</x:Double>
  <x:Double x:Key="AllotFlyoutMaxHeight">640</x:Double>
  <x:Double x:Key="AllotButtonSize">32</x:Double>
  <x:Double x:Key="AllotIconSize">16</x:Double>
  <x:Double x:Key="AllotGroupIconSize">14</x:Double>
  <x:Double x:Key="AllotTileSize">20</x:Double>
  <x:Double x:Key="AllotChipHeight">18</x:Double>
  <x:Double x:Key="AllotEdgeBarHeight">2</x:Double>
  <x:Double x:Key="AllotMeterRowHeight">28</x:Double>
  <x:Double x:Key="AllotResourcesHeaderHeight">40</x:Double>
  <Thickness x:Key="AllotHeaderPadding">14,8,8,6</Thickness>
  <Thickness x:Key="AllotBodyPadding">8,0,8,6</Thickness>
  <Thickness x:Key="AllotResourcesMargin">8,0,8,8</Thickness>
  <Thickness x:Key="AllotGroupHeadingPadding">6,6,6,0</Thickness>
  <Thickness x:Key="AllotIdleLinePadding">6,4,6,2</Thickness>
  <Thickness x:Key="AllotStripPadding">12,5,12,5</Thickness>
  <Thickness x:Key="AllotRowPadding">12,4,4,10</Thickness>
  <Thickness x:Key="AllotChipPadding">8,0,8,0</Thickness>
  <Thickness x:Key="AllotBenchmarkChipPadding">5,0,8,0</Thickness>
  <Thickness x:Key="AllotBannerPadding">10,6,6,6</Thickness>
  <Thickness x:Key="AllotMenuPadding">4</Thickness>
  <Thickness x:Key="AllotMenuItemPadding">12,0,12,0</Thickness>

  <!-- Type ramp. Line heights follow the handoff's size/line pairs; numbers are tabular everywhere. -->
  <Style x:Key="AllotCaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotTextFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextSecondaryBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="AllotBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotTextFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="AllotDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AllotBodyTextStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AllotTextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="AllotGroupHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AllotBodyTextStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextSecondaryBrush}" />
  </Style>
  <Style x:Key="AllotMenuTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotTextFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="AllotSummaryTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotDisplayFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="AllotCommandTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotMonoFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="AllotSessionIdTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotMonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
  </Style>
  <Style x:Key="AllotRowIdTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotMonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextSecondaryBrush}" />
  </Style>
  <Style x:Key="AllotInitialsTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotMonoFontFamily}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="IsTextScaleFactorEnabled" Value="False" />
  </Style>
  <Style x:Key="AllotIconRegularTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AllotIconRegularFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource AllotIconSize}" />
    <Setter Property="Foreground" Value="{ThemeResource AllotTextBrush}" />
    <Setter Property="IsTextScaleFactorEnabled" Value="False" />
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
  </Style>
  <Style x:Key="AllotIconFilledTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AllotIconRegularTextStyle}">
    <Setter Property="FontFamily" Value="{StaticResource AllotIconFilledFontFamily}" />
  </Style>
</ResourceDictionary>
