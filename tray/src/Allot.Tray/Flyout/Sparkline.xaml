<?xml version="1.0" encoding="utf-8"?>
<!-- The CPU row's 36 x 14 sparkline of the last 24 seconds (handoff section 5). -->
<UserControl
  x:Class="Allot.Tray.Flyout.Sparkline"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="36"
  Height="14"
  IsTabStop="False"
  IsHitTestVisible="False">
  <Polyline
    x:Name="Line"
    Stroke="{ThemeResource AllotAccentBrush}"
    StrokeThickness="1.4"
    StrokeLineJoin="Round" />
</UserControl>
