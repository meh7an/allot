<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2 px bar along a job card's bottom (handoff section 4): a track, a fill that grows from the
  left over 900 ms as time ticks, or amber dashes across the whole card for a wait without an
  estimate. The code clips it to the card's rounded bottom corners.
-->
<UserControl
  x:Class="Allot.Tray.Flyout.EdgeBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Height="{StaticResource AllotEdgeBarHeight}"
  IsTabStop="False"
  IsHitTestVisible="False">
  <Grid Background="{ThemeResource AllotTrackBrush}">
    <Grid x:Name="Fill" RenderTransformOrigin="0,0.5">
      <Grid.RenderTransform>
        <ScaleTransform x:Name="FillScale" ScaleX="0" />
      </Grid.RenderTransform>
      <Border x:Name="RunningFill" Background="{ThemeResource AllotRunningBrush}" />
      <Border x:Name="WaitingFill" Background="{ThemeResource AllotWaitingBrush}" Visibility="Collapsed" />
      <Border x:Name="FrozenFill" Background="{ThemeResource AllotStoppedBrush}" Visibility="Collapsed" />
    </Grid>
    <Grid x:Name="Dashes" Background="{ThemeResource AllotWaitingSoftBrush}" Visibility="Collapsed">
      <Path x:Name="DashPath" Fill="{ThemeResource AllotWaitingBrush}" />
    </Grid>
  </Grid>
</UserControl>
