<?xml version="1.0" encoding="utf-8"?>
<!--
  The production flyout (handoff sections 1 to 6): a fixed header with the More options menu, a
  scrolling body (the service-down banner and caption, then rows: job cards, the idle line, the
  first-run card, Recently finished), and the Resources card docked below the body.
-->
<UserControl
  x:Class="Allot.Tray.Flyout.FlyoutShell"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Allot.Tray.Flyout"
  xmlns:vm="using:Allot.Tray.Core.ViewModels">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Lightweight styling of the header buttons: subtle until checked, accent when on. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AllotAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AllotAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AllotAccentForegroundBrush" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AllotTextBrush" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AllotAccentBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AllotAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AllotAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AllotAccentForegroundBrush" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AllotTextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AllotTextBrush" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="AllotHeaderToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="{StaticResource AllotButtonSize}" />
        <Setter Property="Height" Value="{StaticResource AllotButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AllotControlCornerRadius}" />
      </Style>
      <Style x:Key="AllotHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource AllotButtonSize}" />
        <Setter Property="Height" Value="{StaticResource AllotButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AllotControlCornerRadius}" />
      </Style>
      <!--
        Icons inside buttons take the button's foreground, so they have no Foreground here. Every
        icon glyph keeps its size when Windows Text size grows, and is hidden from assistive tech:
        the word beside it, or its button's name, carries the meaning.
      -->
      <Style x:Key="AllotButtonIconRegularStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AllotIconRegularFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AllotIconSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <Style x:Key="AllotButtonIconFilledStyle" TargetType="TextBlock" BasedOn="{StaticResource AllotButtonIconRegularStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AllotIconFilledFontFamily}" />
      </Style>
      <Style x:Key="AllotGroupIconStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AllotGroupIconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <!-- A 14 px glyph inside a line of text: the chip's timer, the detail line's icons. -->
      <Style x:Key="AllotInlineIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AllotIconRegularFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>

      <DataTemplate x:Key="BenchmarkHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource AllotGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource AllotGroupIconStyle}"
            FontFamily="{StaticResource AllotIconRegularFontFamily}"
            Foreground="{ThemeResource AllotBenchmarkBrush}"
            Text="{StaticResource AllotGlyphTimerRegular}" />
          <TextBlock Style="{StaticResource AllotGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="RunningHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource AllotGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource AllotGroupIconStyle}"
            FontFamily="{StaticResource AllotIconFilledFontFamily}"
            Foreground="{ThemeResource AllotRunningBrush}"
            Text="{StaticResource AllotGlyphPlayCircleFilled}" />
          <TextBlock Style="{StaticResource AllotGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="WaitingHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource AllotGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource AllotGroupIconStyle}"
            FontFamily="{StaticResource AllotIconRegularFontFamily}"
            Foreground="{ThemeResource AllotWaitingBrush}"
            Text="{StaticResource AllotGlyphClockRegular}" />
          <TextBlock Style="{StaticResource AllotGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>

      <Style x:Key="AllotChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AllotTextFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <DataTemplate x:Key="JobCardTemplate" x:DataType="vm:JobCardRow">
        <Border
          Background="{ThemeResource AllotCardBrush}"
          BorderBrush="{ThemeResource AllotCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource AllotCardCornerRadius}">
          <StackPanel>
            <!-- Session strip; its radius sits inside the card's 1 px border. -->
            <Border
              Padding="{StaticResource AllotStripPadding}"
              Background="{ThemeResource AllotStripBrush}"
              BorderBrush="{ThemeResource AllotCardBorderBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="5,5,0,0">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  VerticalAlignment="Center"
                  Style="{StaticResource AllotSessionIdTextStyle}"
                  Text="{x:Bind ShortId, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Style="{StaticResource AllotDetailTextStyle}"
                  Foreground="{ThemeResource AllotTextStripBrush}"
                  Text="{x:Bind Project, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind ProjectPath, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Style="{StaticResource AllotBodyTextStyle}"
                  Foreground="{ThemeResource AllotTextStripBrush}"
                  Text="{x:Bind Usage, Mode=OneWay}" />
              </Grid>
            </Border>

            <!-- Job row; the edge bar lies along the card's bottom, under the row's padding. -->
            <Grid>
              <StackPanel Padding="{StaticResource AllotRowPadding}">
                <Grid MinHeight="{StaticResource AllotButtonSize}" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Stopped and Removed cards show tile, command and chip at 50%. -->
                  <local:ProcessTile
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}"
                    Text="{x:Bind Tile, Mode=OneWay}"
                    IsQueued="{x:Bind IsQueued, Mode=OneWay}"
                    ExePath="{x:Bind ExePath, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource AllotCommandTextStyle}"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}"
                    TextDecorations="{x:Bind local:FlyoutShell.StruckThrough(IsStruck), Mode=OneWay}"
                    Text="{x:Bind Command, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Command, Mode=OneWay}" />

                  <!-- Class chip, or the solid Benchmark chip with its timer glyph. -->
                  <Grid
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}">
                    <Border
                      MinHeight="{StaticResource AllotChipHeight}"
                      Padding="{StaticResource AllotChipPadding}"
                      Background="{ThemeResource AllotChipBackgroundBrush}"
                      CornerRadius="{StaticResource AllotChipCornerRadius}"
                      ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}"
                      Visibility="{x:Bind local:FlyoutShell.Hides(IsBenchmark), Mode=OneWay}">
                      <TextBlock
                        Style="{StaticResource AllotChipTextStyle}"
                        Foreground="{ThemeResource AllotChipForegroundBrush}"
                        Text="{x:Bind Chip, Mode=OneWay}" />
                    </Border>
                    <Border
                      MinHeight="{StaticResource AllotChipHeight}"
                      Padding="{StaticResource AllotBenchmarkChipPadding}"
                      Background="{ThemeResource AllotBenchmarkBrush}"
                      CornerRadius="{StaticResource AllotChipCornerRadius}"
                      ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}"
                      Visibility="{x:Bind IsBenchmark, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock
                          VerticalAlignment="Center"
                          Style="{StaticResource AllotInlineIconStyle}"
                          FontSize="12"
                          Foreground="{ThemeResource AllotBenchmarkForegroundBrush}"
                          Text="{StaticResource AllotGlyphTimerRegular}" />
                        <TextBlock
                          Style="{StaticResource AllotChipTextStyle}"
                          Foreground="{ThemeResource AllotBenchmarkForegroundBrush}"
                          Text="{x:Bind Chip, Mode=OneWay}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Kill, its red Kill? confirm, Remove, or a spacer. -->
                  <Grid Grid.Column="3">
                    <Button
                      x:Name="KillButton"
                      Style="{StaticResource AllotHeaderButtonStyle}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ActionName, Mode=OneWay}"
                      Click="OnKillClick"
                      HorizontalAlignment="Right"
                      Visibility="Collapsed"
                      local:ActionMorph.Slides="True"
                      local:ActionMorph.IsShown="{x:Bind local:FlyoutShell.Is(Action, 'Kill'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AllotKillHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AllotKillHoverBrush" />
                      </Button.Resources>
                      <TextBlock
                        Style="{StaticResource AllotButtonIconRegularStyle}"
                        Foreground="{ThemeResource AllotTextSecondaryBrush}"
                        Text="{StaticResource AllotGlyphDismissCircleRegular}" />
                    </Button>
                    <!-- Narrator reads the red detail line as the confirm's help text. -->
                    <Button
                      x:Name="ConfirmButton"
                      MinHeight="{StaticResource AllotButtonSize}"
                      Padding="8,0,10,0"
                      CornerRadius="{StaticResource AllotControlCornerRadius}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Detail, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ActionName, Mode=OneWay}"
                      Click="OnKillClick"
                      KeyDown="OnConfirmKeyDown"
                      LostFocus="OnConfirmLostFocus"
                      Loaded="OnConfirmLoaded"
                      HorizontalAlignment="Right"
                      Visibility="Collapsed"
                      local:ActionMorph.GrowsFrom="{StaticResource AllotButtonSize}"
                      local:ActionMorph.IsShown="{x:Bind local:FlyoutShell.Is(Action, 'Confirm'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="AllotDangerFillBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AllotDangerFillHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AllotDangerFillHoverBrush" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="AllotDangerForegroundBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AllotDangerForegroundBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AllotDangerForegroundBrush" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                      </Button.Resources>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                          Style="{StaticResource AllotInlineIconStyle}"
                          FontFamily="{StaticResource AllotIconFilledFontFamily}"
                          FontSize="16"
                          VerticalAlignment="Center"
                          Text="{StaticResource AllotGlyphDismissCircleFilled}" />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="Kill?" />
                      </StackPanel>
                    </Button>
                    <Button
                      MinHeight="{StaticResource AllotButtonSize}"
                      Padding="8,0,8,0"
                      CornerRadius="{StaticResource AllotControlCornerRadius}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      Click="OnRemoveClick"
                      HorizontalAlignment="Right"
                      Visibility="Collapsed"
                      local:ActionMorph.Slides="True"
                      local:ActionMorph.IsShown="{x:Bind local:FlyoutShell.Is(Action, 'Remove'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AllotMenuHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AllotMenuHoverBrush" />
                      </Button.Resources>
                      <TextBlock
                        Style="{StaticResource AllotBodyTextStyle}"
                        Foreground="{ThemeResource AllotTextSecondaryBrush}"
                        Text="Remove" />
                    </Button>
                    <!--
                      Holds the button's place while a stop is under way; an ended card lets it
                      slide away, and the chip with it. Its 32 px are padding, as the morph owns
                      its Width.
                    -->
                    <Border
                      Height="{StaticResource AllotButtonSize}"
                      Padding="32,0,0,0"
                      Visibility="Collapsed"
                      local:ActionMorph.Slides="True"
                      local:ActionMorph.IsShown="{x:Bind local:FlyoutShell.KeepsSpace(Action, IsEnded), Mode=OneWay}" />
                  </Grid>
                </Grid>

                <!--
                  Detail line, inset to align with the command. A benchmark's status line leads
                  with a 14 px icon and wraps instead of truncating.
                -->
                <Grid Margin="28,0,8,0" ColumnSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource AllotInlineIconStyle}"
                    Foreground="{ThemeResource AllotBenchmarkBrush}"
                    Text="{StaticResource AllotGlyphTimerRegular}"
                    Visibility="{x:Bind local:FlyoutShell.ShowsIcon(Icon, 'Timer'), Mode=OneWay}" />
                  <TextBlock
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource AllotInlineIconStyle}"
                    FontFamily="{StaticResource AllotIconFilledFontFamily}"
                    Foreground="{ThemeResource AllotRunningBrush}"
                    Text="{StaticResource AllotGlyphCheckmarkCircleFilled}"
                    Visibility="{x:Bind local:FlyoutShell.ShowsIcon(Icon, 'Check'), Mode=OneWay}" />
                  <!-- Stopped and Removed lead with a semibold word in full ink. -->
                  <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource AllotDetailTextStyle}"
                    TextWrapping="{x:Bind local:FlyoutShell.Wraps(Icon), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:FlyoutShell.Tip(DetailTooltip), Mode=OneWay}"
                    Visibility="{x:Bind local:FlyoutShell.Hides(DetailIsDanger), Mode=OneWay}">
                    <Run FontWeight="SemiBold" Foreground="{ThemeResource AllotTextBrush}" Text="{x:Bind Strong, Mode=OneWay}" /><Run Text="{x:Bind Detail, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource AllotDetailTextStyle}"
                    Foreground="{ThemeResource AllotDangerTextBrush}"
                    Text="{x:Bind Detail, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:FlyoutShell.Tip(DetailTooltip), Mode=OneWay}"
                    Visibility="{x:Bind DetailIsDanger, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource AllotBodyTextStyle}"
                    Foreground="{ThemeResource AllotTextSecondaryBrush}"
                    Text="{x:Bind Time, Mode=OneWay}"
                    Visibility="{x:Bind local:FlyoutShell.Hides(TimeIsWarning), Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource AllotBodyTextStyle}"
                    Foreground="{ThemeResource AllotWaitingBrush}"
                    Text="{x:Bind Time, Mode=OneWay}"
                    Visibility="{x:Bind TimeIsWarning, Mode=OneWay}" />
                </Grid>

                <!-- A benchmark's Drain / Quiet / Run stepper. -->
                <local:BenchmarkStepper
                  Margin="28,8,8,0"
                  Step="{x:Bind Step, Mode=OneWay}"
                  Ticks="{x:Bind QuietTicks, Mode=OneWay}"
                  RunFraction="{x:Bind RunFraction, Mode=OneWay}"
                  Visibility="{x:Bind HasSteps, Mode=OneWay}" />
              </StackPanel>
              <local:EdgeBar
                VerticalAlignment="Bottom"
                Fraction="{x:Bind BarFraction, Mode=OneWay}"
                Tone="{x:Bind BarTone, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="IdleLineTemplate" x:DataType="vm:IdleRow">
        <Grid Padding="{StaticResource AllotIdleLinePadding}" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource AllotGroupHeadingTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
          <TextBlock
            Grid.Column="1"
            Style="{StaticResource AllotSessionIdTextStyle}"
            Foreground="{ThemeResource AllotTextSecondaryBrush}"
            Text="{x:Bind Ids, Mode=OneWay}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            Style="{StaticResource AllotBodyTextStyle}"
            Foreground="{ThemeResource AllotTextSecondaryBrush}"
            Text="{x:Bind Usage, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <!-- The first-run card (handoff section 4). -->
      <DataTemplate x:Key="WelcomeTemplate" x:DataType="vm:WelcomeRow">
        <Border
          Padding="12"
          Background="{ThemeResource AllotCardBrush}"
          BorderBrush="{ThemeResource AllotCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource AllotCardCornerRadius}">
          <StackPanel Spacing="8">
            <TextBlock
              Style="{StaticResource AllotBodyTextStyle}"
              FontSize="14"
              LineHeight="20"
              FontWeight="SemiBold"
              Text="Welcome to Allot" />
            <TextBlock
              Style="{StaticResource AllotBodyTextStyle}"
              Foreground="{ThemeResource AllotTextSecondaryBrush}"
              TextWrapping="WrapWholeWords"
              Text="When a Claude Code session runs a build, test suite or training job, it reserves cores, RAM or GPU here first. Jobs that don't fit wait their turn. You'll see each one here and can stop it." />
            <Grid
              MinHeight="40"
              Padding="0,4,0,0"
              BorderBrush="{ThemeResource AllotSeparatorBrush}"
              BorderThickness="0,1,0,0"
              ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Style="{StaticResource AllotMenuTextStyle}" Text="Launch at logon" />
              <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource AllotBodyTextStyle}"
                Foreground="{ThemeResource AllotTextSecondaryBrush}"
                Text="{x:Bind local:FlyoutShell.OnOff(LaunchAtLogon), Mode=OneWay}"
                AutomationProperties.AccessibilityView="Raw" />
              <!-- The state text sits before the switch, as in the handoff; the switch's own is empty. -->
              <ToggleSwitch
                Grid.Column="2"
                MinWidth="0"
                VerticalAlignment="Center"
                OnContent=""
                OffContent=""
                AutomationProperties.Name="Launch at logon"
                IsOn="{x:Bind LaunchAtLogon, Mode=OneWay}"
                Toggled="OnLaunchAtLogonToggled" />
            </Grid>
            <Button
              HorizontalAlignment="Right"
              MinHeight="{StaticResource AllotButtonSize}"
              Padding="16,0,16,0"
              BorderThickness="1"
              CornerRadius="{StaticResource AllotControlCornerRadius}"
              FontSize="12"
              Content="Done"
              Click="OnFirstRunDoneClick">
              <Button.Resources>
                <StaticResource x:Key="ButtonBackground" ResourceKey="AllotCardBrush" />
                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AllotCardBorderBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AllotCardBorderBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AllotCardBorderBrush" />
              </Button.Resources>
            </Button>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="NothingTemplate" x:DataType="vm:NothingRow">
        <TextBlock Padding="12,14,12,14" Style="{StaticResource AllotMenuTextStyle}" Text="No jobs running or waiting." />
      </DataTemplate>

      <DataTemplate x:Key="RecentLineTemplate" x:DataType="vm:RecentLine">
        <Grid
          MinHeight="36"
          Padding="12,0,12,0"
          BorderBrush="{ThemeResource AllotSeparatorBrush}"
          BorderThickness="{x:Bind local:FlyoutShell.TopLine(First)}"
          ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource AllotCommandTextStyle}"
            Text="{x:Bind Command}"
            ToolTipService.ToolTip="{x:Bind Command}" />
          <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource AllotRowIdTextStyle}"
            Text="{x:Bind ShortId}" />
          <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Style="{StaticResource AllotBodyTextStyle}"
            Foreground="{ThemeResource AllotTextSecondaryBrush}"
            Text="{x:Bind Meta}" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="RecentTemplate" x:DataType="vm:RecentRow">
        <StackPanel Spacing="6">
          <StackPanel Padding="{StaticResource AllotGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
            <TextBlock
              Style="{StaticResource AllotGroupIconStyle}"
              FontFamily="{StaticResource AllotIconFilledFontFamily}"
              Foreground="{ThemeResource AllotRunningBrush}"
              Text="{StaticResource AllotGlyphCheckmarkCircleFilled}" />
            <TextBlock Style="{StaticResource AllotGroupHeadingTextStyle}" Text="Recently finished" />
          </StackPanel>
          <Border
            Background="{ThemeResource AllotCardBrush}"
            BorderBrush="{ThemeResource AllotCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AllotCardCornerRadius}">
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Lines}"
              ItemTemplate="{StaticResource RecentLineTemplate}" />
          </Border>
        </StackPanel>
      </DataTemplate>

      <!--
        A copy of WinUI's DefaultMenuFlyoutSubItemStyle with a trailing count before the chevron
        (Meters 4 of 5), taken from the item's Tag.
      -->
      <Style x:Key="AllotCountedSubItemStyle" TargetType="MenuFlyoutSubItem">
        <Setter Property="Background" Value="{ThemeResource MenuFlyoutSubItemBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutSubItemBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MenuFlyoutSubItemBorderThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutSubItemForeground}" />
        <Setter Property="Padding" Value="{StaticResource MenuFlyoutItemThemePadding}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuFlyoutSubItem">
              <Grid
                x:Name="LayoutRoot"
                Margin="{StaticResource MenuFlyoutItemMargin}"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundPointerOver}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPointerOver}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronPointerOver}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundPressed}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPressed}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronPressed}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SubMenuOpened">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundSubMenuOpened}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronSubMenuOpened}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundDisabled}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundDisabled}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronDisabled}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundDisabled}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CheckPlaceholderStates">
                    <VisualState x:Name="NoPlaceholder" />
                    <VisualState x:Name="CheckPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IconPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Visibility" Value="Visible" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckAndIconPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemDoublePlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Visibility" Value="Visible" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="PaddingSizeStates">
                    <VisualState x:Name="DefaultPadding" />
                    <VisualState x:Name="NarrowPadding">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Padding">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox
                    x:Name="IconRoot"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
                  </Viewbox>
                  <TextBlock
                    x:Name="TextBlock"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Foreground="{TemplateBinding Foreground}"
                    Text="{TemplateBinding Text}"
                    TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}" />
                  <!--
                    The count. Tag is WinUI's own property, which WinUI resolves itself, so this
                    runtime binding works in the Native AOT build too (checked by eye); the
                    XamlCompiler still warns WMC1510 about it in Release.
                  -->
                  <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource AllotBodyTextStyle}"
                    Foreground="{ThemeResource AllotTextSecondaryBrush}"
                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    AutomationProperties.AccessibilityView="Raw" />
                  <FontIcon
                    x:Name="SubItemChevron"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource MenuFlyoutSubItemChevron}"
                    Glyph="&#xE974;"
                    MirroredWhenRightToLeft="True" />
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        Meter and drive rows: label 48, bar, value 108 at 100% text; the code widens the label and
        value columns with Windows Text size, alike in every row (OnMeterRowLoaded).
      -->
      <DataTemplate x:Key="MeterRowTemplate" x:DataType="vm:MeterRowModel">
        <Grid
          MinHeight="28"
          Padding="12,0,12,0"
          ColumnSpacing="8"
          Loaded="OnMeterRowLoaded"
          Unloaded="OnMeterRowUnloaded"
          SizeChanged="OnMeterRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="108" />
          </Grid.ColumnDefinitions>
          <!-- Narrator reads the row from its value: "CPU 64%", then the bar's tooltip. -->
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource AllotBodyTextStyle}"
            FontWeight="SemiBold"
            AutomationProperties.AccessibilityView="Raw"
            Text="{x:Bind Label, Mode=OneWay}" />
          <!-- The tooltip covers the row's height, as the 6 px bar alone is hard to hover. -->
          <Grid
            Grid.Column="1"
            Background="Transparent"
            ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
            <local:BulletBar
              Used="{x:Bind Used, Mode=OneWay}"
              Reserved="{x:Bind Reserved, Mode=OneWay}"
              HasReserved="{x:Bind HasReserved, Mode=OneWay}"
              Headroom="{x:Bind Headroom, Mode=OneWay}" />
          </Grid>
          <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <local:Sparkline
              VerticalAlignment="Center"
              Samples="{x:Bind Spark, Mode=OneWay}"
              Visibility="{x:Bind HasSpark, Mode=OneWay}" />
            <TextBlock
              Style="{StaticResource AllotBodyTextStyle}"
              TextTrimming="CharacterEllipsis"
              AutomationProperties.Name="{x:Bind local:FlyoutShell.Spoken(Label, Value), Mode=OneWay}"
              AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}"
              Text="{x:Bind Value, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="DriveRowTemplate" x:DataType="vm:DriveRowModel">
        <Grid
          MinHeight="28"
          Padding="12,0,12,0"
          ColumnSpacing="8"
          Loaded="OnMeterRowLoaded"
          Unloaded="OnMeterRowUnloaded"
          SizeChanged="OnMeterRowSizeChanged">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="108" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource AllotBodyTextStyle}"
            FontWeight="SemiBold"
            Text="{x:Bind Label}" />
          <Grid Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The fill and the rest of the track share the bar as star columns. -->
            <Grid
              Height="4"
              VerticalAlignment="Center"
              Background="{ThemeResource AllotTrackBrush}"
              CornerRadius="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind local:FlyoutShell.Share(Used), Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind local:FlyoutShell.RestShare(Used), Mode=OneWay}" />
              </Grid.ColumnDefinitions>
              <Border Background="{ThemeResource AllotDriveBrush}" CornerRadius="2" />
            </Grid>
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Style="{StaticResource AllotCaptionTextStyle}"
              Text="{x:Bind Activity, Mode=OneWay}" />
          </Grid>
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource AllotBodyTextStyle}"
            TextTrimming="CharacterEllipsis"
            Text="{x:Bind Value, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="AllotLegendTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AllotCaptionTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <local:RowTemplateSelector
        x:Key="RowTemplates"
        BenchmarkHeading="{StaticResource BenchmarkHeadingTemplate}"
        RunningHeading="{StaticResource RunningHeadingTemplate}"
        WaitingHeading="{StaticResource WaitingHeadingTemplate}"
        JobCard="{StaticResource JobCardTemplate}"
        IdleLine="{StaticResource IdleLineTemplate}"
        Welcome="{StaticResource WelcomeTemplate}"
        Nothing="{StaticResource NothingTemplate}"
        Recent="{StaticResource RecentTemplate}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <!--
    DWM draws the flyout's 1 px edge (FlyoutWindow.ApplyBorderColor). Tab order is the tree's
    (handoff, Keyboard), wrapping from the last control to the first.
  -->
  <Border CornerRadius="{StaticResource AllotFlyoutCornerRadius}" TabFocusNavigation="Cycle">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: its empty space is the drag handle while pinned. -->
      <Grid
        x:Name="Header"
        Padding="{StaticResource AllotHeaderPadding}"
        Background="Transparent"
        SizeChanged="OnHeaderSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The Allot mark as the 16 px tray icon draws it (assets/brand/build.py): bars snapped
             to whole pixels, half opacity while idle. -->
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Canvas
            Opacity="{x:Bind local:FlyoutShell.MarkOpacity(Model.Glyph), Mode=OneWay}"
            Visibility="{x:Bind local:FlyoutShell.ShowsMark(Model.Glyph), Mode=OneWay}">
            <Rectangle Canvas.Left="6" Canvas.Top="1" Width="4" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="5" Canvas.Top="4" Width="6" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="3" Canvas.Top="7" Width="3" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="10" Canvas.Top="7" Width="3" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="2" Canvas.Top="10" Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="1" Canvas.Top="13" Width="3" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
            <Rectangle Canvas.Left="12" Canvas.Top="13" Width="3" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource AllotTextBrush}" />
          </Canvas>
          <TextBlock
            Style="{StaticResource AllotIconFilledTextStyle}"
            Foreground="{ThemeResource AllotDangerTextBrush}"
            Text="{StaticResource AllotGlyphErrorCircleFilled}"
            Visibility="{x:Bind local:FlyoutShell.Shows(Model.Glyph, 'Error'), Mode=OneWay}" />
        </Grid>

        <TextBlock
          x:Name="SummaryText"
          Grid.Column="1"
          Margin="10,0,10,0"
          VerticalAlignment="Center"
          Style="{StaticResource AllotSummaryTextStyle}"
          AutomationProperties.LiveSetting="Polite"
          Text="{x:Bind Model.Summary, Mode=OneWay}" />

        <!-- Pin exists only while Stay open is on; the wrapper's width reveals it. -->
        <Grid
          x:Name="PinWrapper"
          Grid.Column="2"
          Width="0"
          SizeChanged="OnPinWrapperSizeChanged">
          <ToggleButton
            x:Name="PinButton"
            HorizontalAlignment="Left"
            Opacity="0"
            IsTabStop="False"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw"
            AutomationProperties.Name="Pin"
            ToolTipService.ToolTip="Pin"
            Style="{StaticResource AllotHeaderToggleStyle}"
            Click="OnPinClick">
            <Grid>
              <TextBlock x:Name="PinIcon" Style="{StaticResource AllotButtonIconRegularStyle}" Text="{StaticResource AllotGlyphPinRegular}" />
              <TextBlock x:Name="PinnedIcon" Style="{StaticResource AllotButtonIconFilledStyle}" Text="{StaticResource AllotGlyphPinFilled}" Visibility="Collapsed" />
            </Grid>
          </ToggleButton>
        </Grid>

        <ToggleButton
          x:Name="StayOpenButton"
          Grid.Column="3"
          AutomationProperties.Name="Stay open"
          ToolTipService.ToolTip="Stay open"
          Style="{StaticResource AllotHeaderToggleStyle}"
          Click="OnStayOpenClick">
          <Grid>
            <TextBlock x:Name="LockOpenIcon" Style="{StaticResource AllotButtonIconRegularStyle}" Text="{StaticResource AllotGlyphLockOpenRegular}" />
            <TextBlock x:Name="LockClosedIcon" Style="{StaticResource AllotButtonIconFilledStyle}" Text="{StaticResource AllotGlyphLockClosedFilled}" Visibility="Collapsed" />
          </Grid>
        </ToggleButton>

        <!-- The pressed look stays on while the menu is open. -->
        <Grid Grid.Column="4" Margin="4,0,0,0">
          <Border
            x:Name="MorePressed"
            Background="{ThemeResource AllotPressedBrush}"
            CornerRadius="{StaticResource AllotControlCornerRadius}"
            Opacity="0" />
          <local:ExpandButton
            x:Name="MoreButton"
            AutomationProperties.Name="More options"
            ToolTipService.ToolTip="More options"
            Style="{StaticResource AllotHeaderButtonStyle}">
            <TextBlock Style="{StaticResource AllotButtonIconRegularStyle}" Text="{StaticResource AllotGlyphMoreHorizontalRegular}" />
            <Button.Flyout>
              <MenuFlyout
                x:Name="MoreMenu"
                Placement="BottomEdgeAlignedRight"
                Opened="OnMenuOpened"
                Closing="OnMenuClosing"
                Closed="OnMenuClosed">
                <MenuFlyoutSubItem
                  Text="Meters"
                  Tag="{x:Bind Model.MetersCount, Mode=OneWay}"
                  Style="{StaticResource AllotCountedSubItemStyle}">
                  <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="{StaticResource AllotIconRegularFontFamily}" Glyph="{StaticResource AllotGlyphDataBarHorizontalRegular}" />
                  </MenuFlyoutSubItem.Icon>
                  <ToggleMenuFlyoutItem x:Name="CpuItem" Text="CPU" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="RamItem" Text="RAM" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="GpuItem" Text="GPU" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="VramItem" Text="VRAM" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="DrivesItem" Text="Drives" Click="OnMeterClick" />
                  <!-- Indented under Drives, and disabled while Drives is off. -->
                  <ToggleMenuFlyoutItem
                    x:Name="DriveActivityItem"
                    Margin="16,0,0,0"
                    Text="Drive activity"
                    Click="OnMeterClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem
                  Text="Notifications"
                  Tag="{x:Bind Model.NotificationsCount, Mode=OneWay}"
                  Style="{StaticResource AllotCountedSubItemStyle}">
                  <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="{StaticResource AllotIconRegularFontFamily}" Glyph="{StaticResource AllotGlyphAlertRegular}" />
                  </MenuFlyoutSubItem.Icon>
                  <ToggleMenuFlyoutItem x:Name="ServiceStoppedItem" Text="Service stopped" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="RunningLongItem" Text="Running long" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="BenchmarkFinishedItem" Text="Benchmark finished" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="JobFinishedItem" Text="Job finished" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="KilledOutsideItem" Text="Killed outside the flyout" Click="OnNotificationClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open logs" Click="OnOpenLogsClick">
                  <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource AllotIconRegularFontFamily}" Glyph="{StaticResource AllotGlyphDocumentTextRegular}" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </local:ExpandButton>
        </Grid>
      </Grid>

      <!--
        Top-aligned, so the panel's height is its content's: stretched, it would fill the
        viewport and report the window's own height back as the height it needs.
      -->
      <ScrollViewer
        x:Name="BodyScroller"
        Grid.Row="1"
        VerticalScrollBarVisibility="Auto"
        SizeChanged="OnBodyScrollerSizeChanged">
        <StackPanel
          x:Name="BodyPanel"
          VerticalAlignment="Top"
          Padding="{StaticResource AllotBodyPadding}"
          Spacing="6"
          SizeChanged="OnBodySizeChanged">
          <!-- Service down (handoff section 6): the banner, then the caption over the dimmed rows. -->
          <Border
            Padding="{StaticResource AllotBannerPadding}"
            Background="{ThemeResource AllotBannerBackgroundBrush}"
            BorderBrush="{ThemeResource AllotBannerBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AllotCardCornerRadius}"
            Visibility="{x:Bind local:FlyoutShell.ShowsBanner(Model.Banner), Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource AllotInlineIconStyle}"
                FontFamily="{StaticResource AllotIconFilledFontFamily}"
                FontSize="16"
                Foreground="{ThemeResource AllotBannerForegroundBrush}"
                Text="{StaticResource AllotGlyphErrorCircleFilled}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                  Style="{StaticResource AllotBodyTextStyle}"
                  FontWeight="SemiBold"
                  Foreground="{ThemeResource AllotBannerForegroundBrush}"
                  TextWrapping="WrapWholeWords"
                  Text="{x:Bind local:FlyoutShell.BannerText(Model.Banner), Mode=OneWay}" />
                <!-- Why the last Start service failed. -->
                <TextBlock
                  Style="{StaticResource AllotBodyTextStyle}"
                  Foreground="{ThemeResource AllotBannerForegroundBrush}"
                  TextWrapping="Wrap"
                  Text="{x:Bind local:FlyoutShell.BannerProblem(Model.Banner), Mode=OneWay}"
                  Visibility="{x:Bind local:FlyoutShell.ShowsProblem(Model.Banner), Mode=OneWay}" />
              </StackPanel>
              <!-- Start service; Starting… is the same button, disabled in the muted accent. -->
              <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                MinHeight="{StaticResource AllotButtonSize}"
                Padding="12,0,12,0"
                CornerRadius="{StaticResource AllotControlCornerRadius}"
                FontSize="12"
                FontWeight="SemiBold"
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind local:FlyoutShell.StartText(Model.Banner), Mode=OneWay}"
                IsEnabled="{x:Bind local:FlyoutShell.CanStart(Model.Banner), Mode=OneWay}"
                Visibility="{x:Bind local:FlyoutShell.ShowsStart(Model.Banner), Mode=OneWay}"
                Click="OnStartServiceClick">
                <Button.Resources>
                  <StaticResource x:Key="AccentButtonBackground" ResourceKey="AllotAccentBrush" />
                  <StaticResource x:Key="AccentButtonForeground" ResourceKey="AllotAccentForegroundBrush" />
                  <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="AllotAccentBusyBrush" />
                  <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="AllotAccentForegroundBrush" />
                  <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
                </Button.Resources>
              </Button>
            </Grid>
          </Border>
          <TextBlock
            Padding="6,4,6,0"
            Style="{StaticResource AllotBodyTextStyle}"
            Foreground="{ThemeResource AllotTextSecondaryBrush}"
            Text="{x:Bind local:FlyoutShell.Caption(Model.Banner), Mode=OneWay}"
            Visibility="{x:Bind local:FlyoutShell.ShowsCaption(Model.Banner), Mode=OneWay}" />
          <StackPanel
            x:Name="RowsPanel"
            Opacity="{x:Bind local:FlyoutShell.Dimmed(Model.IsLastKnown), Mode=OneWay}" />
        </StackPanel>
      </ScrollViewer>

      <!-- The Resources card stays docked below the body while the rows scroll. -->
      <Border
        x:Name="ResourcesCard"
        Grid.Row="2"
        Margin="{StaticResource AllotResourcesMargin}"
        Background="{ThemeResource AllotCardBrush}"
        BorderBrush="{ThemeResource AllotCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource AllotCardCornerRadius}"
        SizeChanged="OnResourcesSizeChanged"
        Visibility="{x:Bind Model.Resources.Visible, Mode=OneWay}">
        <StackPanel>
          <!-- The whole header toggles the card; the chevron stays as its keyboard target. -->
          <Grid
            MinHeight="40"
            Padding="12,0,4,0"
            Background="Transparent"
            ColumnSpacing="8"
            Tapped="OnResourcesHeaderTapped">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource AllotBodyTextStyle}"
              FontWeight="SemiBold"
              Text="Resources" />
            <TextBlock
              x:Name="ResourcesSummary"
              Grid.Column="1"
              VerticalAlignment="Center"
              Style="{StaticResource AllotDetailTextStyle}"
              Text="{x:Bind Model.Resources.Summary, Mode=OneWay}" />
            <local:ExpandButton
              x:Name="ResourcesToggle"
              Grid.Column="2"
              Style="{StaticResource AllotHeaderButtonStyle}"
              IsExpanded="{x:Bind Model.Resources.Expanded, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind local:FlyoutShell.ResourcesToggleName(Model.Resources.Expanded), Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind local:FlyoutShell.ResourcesToggleName(Model.Resources.Expanded), Mode=OneWay}"
              Click="OnResourcesToggleClick">
              <Grid>
                <TextBlock
                  Style="{StaticResource AllotButtonIconRegularStyle}"
                  Text="{StaticResource AllotGlyphChevronUpRegular}"
                  Visibility="{x:Bind local:FlyoutShell.Hides(Model.Resources.Expanded), Mode=OneWay}" />
                <TextBlock
                  Style="{StaticResource AllotButtonIconRegularStyle}"
                  Text="{StaticResource AllotGlyphChevronDownRegular}"
                  Visibility="{x:Bind Model.Resources.Expanded, Mode=OneWay}" />
              </Grid>
            </local:ExpandButton>
          </Grid>

          <!-- Shown, hidden and animated by the code as the card expands and collapses. -->
          <StackPanel
            x:Name="ResourcesRows"
            Padding="0,0,0,8"
            Spacing="2"
            Visibility="Collapsed">
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Model.Resources.Meters}"
              ItemTemplate="{StaticResource MeterRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border
              Height="1"
              Margin="12,4,12,4"
              Background="{ThemeResource AllotSeparatorBrush}"
              Visibility="{x:Bind Model.Resources.ShowSeparator, Mode=OneWay}" />
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Model.Resources.Drives}"
              ItemTemplate="{StaticResource DriveRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock
              Padding="12,4,12,4"
              Style="{StaticResource AllotDetailTextStyle}"
              TextWrapping="WrapWholeWords"
              Text="All meters are off. Turn them on from ⋯ › Meters."
              Visibility="{x:Bind Model.Resources.AllOff, Mode=OneWay}" />
            <StackPanel
              Padding="12,6,12,0"
              Orientation="Horizontal"
              Spacing="12"
              Visibility="{x:Bind Model.Resources.ShowLegend, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border
                  Width="10"
                  Height="6"
                  VerticalAlignment="Center"
                  Background="{ThemeResource AllotAccentBrush}"
                  CornerRadius="1" />
                <TextBlock Style="{StaticResource AllotLegendTextStyle}" Text="Used" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border
                  Width="2"
                  Height="10"
                  VerticalAlignment="Center"
                  Background="{ThemeResource AllotMarkerBrush}" />
                <TextBlock Style="{StaticResource AllotLegendTextStyle}" Text="Reserved" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <local:BulletBar Width="10" Headroom="0" />
                <TextBlock Style="{StaticResource AllotLegendTextStyle}" Text="Headroom" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
