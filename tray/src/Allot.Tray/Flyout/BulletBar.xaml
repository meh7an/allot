<?xml version="1.0" encoding="utf-8"?>
<!--
  A meter's 6 px bullet bar (handoff section 5): a track whose last part is hatched headroom
  that leases can't take, the used fill in accent from the left, and the reserved tick, a 2 x 14
  ink mark ringed in the surface colour. The tick sits in a canvas so it can reach above and
  below the bar.
-->
<UserControl
  x:Class="Allot.Tray.Flyout.BulletBar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Height="6"
  VerticalAlignment="Center"
  IsTabStop="False">
  <Grid>
    <Grid x:Name="Bar" Background="{ThemeResource AllotTrackBrush}">
      <Grid
        x:Name="Hatch"
        HorizontalAlignment="Right"
        Background="{ThemeResource AllotHatchWeakBrush}">
        <Path x:Name="Stripes" Stroke="{ThemeResource AllotHatchStrongBrush}" StrokeThickness="1.5" />
      </Grid>
      <!-- Full width, slid left by the unused share; the bar's clip hides what is outside. -->
      <Border
        x:Name="Fill"
        HorizontalAlignment="Left"
        Background="{ThemeResource AllotAccentBrush}"
        CornerRadius="2">
        <Border.RenderTransform>
          <TranslateTransform x:Name="FillShift" />
        </Border.RenderTransform>
      </Border>
    </Grid>
    <Canvas>
      <Border
        x:Name="Tick"
        Canvas.Top="-5"
        Width="4"
        Height="16"
        Background="{ThemeResource AllotMarkerBrush}"
        BorderBrush="{ThemeResource AllotMarkerRingBrush}"
        BorderThickness="1"
        CornerRadius="2"
        Visibility="Collapsed" />
    </Canvas>
  </Grid>
</UserControl>
