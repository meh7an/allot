<?xml version="1.0" encoding="utf-8" ?>
<!--
  The Settings window (DESIGN.md section 10, Windows): Mica, a content-extended title bar, a
  NavigationView of the pages with the save status at the foot of its pane, banners above the
  page and a brief notice with Undo below it. No x:Bind here: a Window whose own XAML binds is
  never collected (microsoft-ui-xaml#9063, M0.2), so the code-behind sets every value.
-->
<Window
  x:Class="Allot.Tray.Settings.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Allot Settings">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="Allot Settings">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="Assets/AppIcon.ico" />
      </TitleBar.IconSource>
    </TitleBar>

    <NavigationView
      x:Name="Nav"
      Grid.Row="1"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="False"
      PaneDisplayMode="Auto"
      CompactModeThresholdWidth="640"
      ExpandedModeThresholdWidth="900"
      OpenPaneLength="232"
      SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Panel" Tag="panel">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEC4A;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Admission" Tag="admission">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9E9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Sizes" Tag="sizes">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE7B8;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Commands" Tag="commands">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE756;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Benchmarks" Tag="benchmarks">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE916;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Leases" Tag="leases">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8D7;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Service" Tag="service">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE770;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <NavigationView.PaneFooter>
        <TextBlock
          x:Name="SaveStatusText"
          Margin="16,8,16,12"
          Style="{StaticResource CaptionTextBlockStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="WrapWholeWords" />
      </NavigationView.PaneFooter>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Banners" Padding="32,16,32,0" Spacing="8" MaxWidth="1064" />
        <ContentControl
          x:Name="PageHost"
          Grid.Row="1"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          IsTabStop="False" />
        <InfoBar
          x:Name="Notice"
          Grid.Row="2"
          Margin="32,0,32,16"
          MaxWidth="1000"
          Severity="Informational"
          IsClosable="True" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
