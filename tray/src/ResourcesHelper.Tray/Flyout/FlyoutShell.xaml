<?xml version="1.0" encoding="utf-8"?>
<!--
  The production flyout (handoff sections 1 to 5): a fixed header with the More options menu, a
  scrolling body of rows (job cards, the idle line, Recently finished), and the Resources card
  docked below the body.
-->
<UserControl
  x:Class="ResourcesHelper.Tray.Flyout.FlyoutShell"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:ResourcesHelper.Tray.Flyout"
  xmlns:vm="using:ResourcesHelper.Tray.Core.ViewModels">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Lightweight styling of the header buttons: subtle until checked, accent when on. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="RhAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="RhAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="RhAccentForegroundBrush" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="RhTextBrush" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="RhAccentBrush" />
          <StaticResource x:Key="ToggleButtonForeground" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="RhAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="RhAccentForegroundBrush" />
          <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="RhAccentForegroundBrush" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
          <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
          <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
          <StaticResource x:Key="ButtonForeground" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="RhTextBrush" />
          <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="RhTextBrush" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="RhHeaderToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="{StaticResource RhButtonSize}" />
        <Setter Property="Height" Value="{StaticResource RhButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RhControlCornerRadius}" />
      </Style>
      <Style x:Key="RhHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource RhButtonSize}" />
        <Setter Property="Height" Value="{StaticResource RhButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RhControlCornerRadius}" />
      </Style>
      <!-- Icons inside buttons take the button's foreground, so they have no Foreground here. -->
      <Style x:Key="RhButtonIconRegularStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RhIconRegularFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource RhIconSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="RhButtonIconFilledStyle" TargetType="TextBlock" BasedOn="{StaticResource RhButtonIconRegularStyle}">
        <Setter Property="FontFamily" Value="{StaticResource RhIconFilledFontFamily}" />
      </Style>
      <Style x:Key="RhGroupIconStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource RhGroupIconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <DataTemplate x:Key="BenchmarkHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource RhGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource RhGroupIconStyle}"
            FontFamily="{StaticResource RhIconRegularFontFamily}"
            Foreground="{ThemeResource RhBenchmarkBrush}"
            Text="{StaticResource RhGlyphTimerRegular}" />
          <TextBlock Style="{StaticResource RhGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="RunningHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource RhGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource RhGroupIconStyle}"
            FontFamily="{StaticResource RhIconFilledFontFamily}"
            Foreground="{ThemeResource RhRunningBrush}"
            Text="{StaticResource RhGlyphPlayCircleFilled}" />
          <TextBlock Style="{StaticResource RhGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="WaitingHeadingTemplate" x:DataType="vm:GroupHeadingRow">
        <StackPanel Padding="{StaticResource RhGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
          <TextBlock
            Style="{StaticResource RhGroupIconStyle}"
            FontFamily="{StaticResource RhIconRegularFontFamily}"
            Foreground="{ThemeResource RhWaitingBrush}"
            Text="{StaticResource RhGlyphClockRegular}" />
          <TextBlock Style="{StaticResource RhGroupHeadingTextStyle}" Text="{x:Bind Heading, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>

      <Style x:Key="RhChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RhTextFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <DataTemplate x:Key="JobCardTemplate" x:DataType="vm:JobCardRow">
        <Border
          Background="{ThemeResource RhCardBrush}"
          BorderBrush="{ThemeResource RhCardBorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource RhCardCornerRadius}">
          <StackPanel>
            <!-- Session strip; its radius sits inside the card's 1 px border. -->
            <Border
              Padding="{StaticResource RhStripPadding}"
              Background="{ThemeResource RhStripBrush}"
              BorderBrush="{ThemeResource RhCardBorderBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="5,5,0,0">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  VerticalAlignment="Center"
                  Style="{StaticResource RhSessionIdTextStyle}"
                  Text="{x:Bind ShortId, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Style="{StaticResource RhDetailTextStyle}"
                  Foreground="{ThemeResource RhTextStripBrush}"
                  Text="{x:Bind Project, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind ProjectPath, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Style="{StaticResource RhBodyTextStyle}"
                  Foreground="{ThemeResource RhTextStripBrush}"
                  Text="{x:Bind Usage, Mode=OneWay}" />
              </Grid>
            </Border>

            <!-- Job row; the edge bar lies along the card's bottom, under the row's padding. -->
            <Grid>
              <StackPanel Padding="{StaticResource RhRowPadding}">
                <Grid Height="{StaticResource RhButtonSize}" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <!-- Stopped and Removed cards show tile, command and chip at 50%. -->
                  <local:ProcessTile
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}"
                    Text="{x:Bind Tile, Mode=OneWay}"
                    IsQueued="{x:Bind IsQueued, Mode=OneWay}"
                    ExePath="{x:Bind ExePath, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource RhCommandTextStyle}"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}"
                    TextDecorations="{x:Bind local:FlyoutShell.StruckThrough(IsEnded), Mode=OneWay}"
                    Text="{x:Bind Command, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Command, Mode=OneWay}" />

                  <!-- Class chip, or the solid Benchmark chip with its timer glyph. -->
                  <Grid
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind local:FlyoutShell.Ended(IsEnded), Mode=OneWay}">
                    <Border
                      Height="{StaticResource RhChipHeight}"
                      Padding="{StaticResource RhChipPadding}"
                      Background="{ThemeResource RhChipBackgroundBrush}"
                      CornerRadius="{StaticResource RhChipCornerRadius}"
                      ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}"
                      Visibility="{x:Bind local:FlyoutShell.Hides(IsBenchmark), Mode=OneWay}">
                      <TextBlock
                        Style="{StaticResource RhChipTextStyle}"
                        Foreground="{ThemeResource RhChipForegroundBrush}"
                        Text="{x:Bind Chip, Mode=OneWay}" />
                    </Border>
                    <Border
                      Height="{StaticResource RhChipHeight}"
                      Padding="{StaticResource RhBenchmarkChipPadding}"
                      Background="{ThemeResource RhBenchmarkBrush}"
                      CornerRadius="{StaticResource RhChipCornerRadius}"
                      ToolTipService.ToolTip="{x:Bind ChipTooltip, Mode=OneWay}"
                      Visibility="{x:Bind IsBenchmark, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource RhIconRegularFontFamily}"
                          FontSize="12"
                          Foreground="{ThemeResource RhBenchmarkForegroundBrush}"
                          Text="{StaticResource RhGlyphTimerRegular}" />
                        <TextBlock
                          Style="{StaticResource RhChipTextStyle}"
                          Foreground="{ThemeResource RhBenchmarkForegroundBrush}"
                          Text="{x:Bind Chip, Mode=OneWay}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Kill, its red Kill? confirm, Remove, or a spacer. -->
                  <Grid Grid.Column="3">
                    <Button
                      x:Name="KillButton"
                      Style="{StaticResource RhHeaderButtonStyle}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      ToolTipService.ToolTip="Kill"
                      Click="OnKillClick"
                      Visibility="{x:Bind local:FlyoutShell.ShowsAction(Action, 'Kill'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="RhKillHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="RhKillHoverBrush" />
                      </Button.Resources>
                      <TextBlock
                        Style="{StaticResource RhButtonIconRegularStyle}"
                        Foreground="{ThemeResource RhTextSecondaryBrush}"
                        Text="{StaticResource RhGlyphDismissCircleRegular}" />
                    </Button>
                    <Button
                      x:Name="ConfirmButton"
                      Height="{StaticResource RhButtonSize}"
                      Padding="8,0,10,0"
                      CornerRadius="{StaticResource RhControlCornerRadius}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      Click="OnKillClick"
                      KeyDown="OnConfirmKeyDown"
                      LostFocus="OnConfirmLostFocus"
                      Loaded="OnConfirmLoaded"
                      Visibility="{x:Bind local:FlyoutShell.ShowsAction(Action, 'Confirm'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackground" ResourceKey="RhDangerFillBrush" />
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="RhDangerFillHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="RhDangerFillHoverBrush" />
                        <StaticResource x:Key="ButtonForeground" ResourceKey="RhDangerForegroundBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="RhDangerForegroundBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="RhDangerForegroundBrush" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                      </Button.Resources>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                          FontFamily="{StaticResource RhIconFilledFontFamily}"
                          FontSize="16"
                          VerticalAlignment="Center"
                          Text="{StaticResource RhGlyphDismissCircleFilled}" />
                        <TextBlock
                          VerticalAlignment="Center"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="Kill?" />
                      </StackPanel>
                    </Button>
                    <Button
                      Height="{StaticResource RhButtonSize}"
                      Padding="8,0,8,0"
                      CornerRadius="{StaticResource RhControlCornerRadius}"
                      AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                      Click="OnRemoveClick"
                      Visibility="{x:Bind local:FlyoutShell.ShowsAction(Action, 'Remove'), Mode=OneWay}">
                      <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="RhMenuHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="RhMenuHoverBrush" />
                      </Button.Resources>
                      <TextBlock
                        Style="{StaticResource RhBodyTextStyle}"
                        Foreground="{ThemeResource RhTextSecondaryBrush}"
                        Text="Remove" />
                    </Button>
                    <Border
                      Width="{StaticResource RhButtonSize}"
                      Height="{StaticResource RhButtonSize}"
                      Visibility="{x:Bind local:FlyoutShell.ShowsAction(Action, 'None'), Mode=OneWay}" />
                  </Grid>
                </Grid>

                <!--
                  Detail line, inset to align with the command. A benchmark's status line leads
                  with a 14 px icon and wraps instead of truncating.
                -->
                <Grid Margin="28,0,8,0" ColumnSpacing="6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource RhIconRegularFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource RhBenchmarkBrush}"
                    Text="{StaticResource RhGlyphTimerRegular}"
                    Visibility="{x:Bind local:FlyoutShell.ShowsIcon(Icon, 'Timer'), Mode=OneWay}" />
                  <TextBlock
                    Margin="0,1,0,0"
                    VerticalAlignment="Top"
                    FontFamily="{StaticResource RhIconFilledFontFamily}"
                    FontSize="14"
                    Foreground="{ThemeResource RhRunningBrush}"
                    Text="{StaticResource RhGlyphCheckmarkCircleFilled}"
                    Visibility="{x:Bind local:FlyoutShell.ShowsIcon(Icon, 'Check'), Mode=OneWay}" />
                  <!-- Stopped and Removed lead with a semibold word in full ink. -->
                  <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource RhDetailTextStyle}"
                    TextWrapping="{x:Bind local:FlyoutShell.Wraps(Icon), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:FlyoutShell.Tip(DetailTooltip), Mode=OneWay}"
                    Visibility="{x:Bind local:FlyoutShell.Hides(DetailIsDanger), Mode=OneWay}">
                    <Run FontWeight="SemiBold" Foreground="{ThemeResource RhTextBrush}" Text="{x:Bind Strong, Mode=OneWay}" /><Run Text="{x:Bind Detail, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource RhDetailTextStyle}"
                    Foreground="{ThemeResource RhDangerTextBrush}"
                    Text="{x:Bind Detail, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:FlyoutShell.Tip(DetailTooltip), Mode=OneWay}"
                    Visibility="{x:Bind DetailIsDanger, Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource RhBodyTextStyle}"
                    Foreground="{ThemeResource RhTextSecondaryBrush}"
                    Text="{x:Bind Time, Mode=OneWay}"
                    Visibility="{x:Bind local:FlyoutShell.Hides(TimeIsWarning), Mode=OneWay}" />
                  <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource RhBodyTextStyle}"
                    Foreground="{ThemeResource RhWaitingBrush}"
                    Text="{x:Bind Time, Mode=OneWay}"
                    Visibility="{x:Bind TimeIsWarning, Mode=OneWay}" />
                </Grid>

                <!-- A benchmark's Drain / Quiet / Run stepper. -->
                <local:BenchmarkStepper
                  Margin="28,8,8,0"
                  Step="{x:Bind Step, Mode=OneWay}"
                  Ticks="{x:Bind QuietTicks, Mode=OneWay}"
                  RunFraction="{x:Bind RunFraction, Mode=OneWay}"
                  Visibility="{x:Bind HasSteps, Mode=OneWay}" />
              </StackPanel>
              <local:EdgeBar
                VerticalAlignment="Bottom"
                Fraction="{x:Bind BarFraction, Mode=OneWay}"
                Tone="{x:Bind BarTone, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="IdleLineTemplate" x:DataType="vm:IdleRow">
        <Grid Padding="{StaticResource RhIdleLinePadding}" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource RhGroupHeadingTextStyle}" Text="{x:Bind Label, Mode=OneWay}" />
          <TextBlock
            Grid.Column="1"
            Style="{StaticResource RhSessionIdTextStyle}"
            Foreground="{ThemeResource RhTextSecondaryBrush}"
            Text="{x:Bind Ids, Mode=OneWay}" />
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            Style="{StaticResource RhBodyTextStyle}"
            Foreground="{ThemeResource RhTextSecondaryBrush}"
            Text="{x:Bind Usage, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="NothingTemplate" x:DataType="vm:NothingRow">
        <TextBlock Padding="12,14,12,14" Style="{StaticResource RhMenuTextStyle}" Text="No jobs running or waiting." />
      </DataTemplate>

      <DataTemplate x:Key="RecentLineTemplate" x:DataType="vm:RecentLine">
        <Grid
          MinHeight="36"
          Padding="12,0,12,0"
          BorderBrush="{ThemeResource RhSeparatorBrush}"
          BorderThickness="{x:Bind local:FlyoutShell.TopLine(First)}"
          ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RhCommandTextStyle}"
            Text="{x:Bind Command}"
            ToolTipService.ToolTip="{x:Bind Command}" />
          <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Style="{StaticResource RhRowIdTextStyle}"
            Text="{x:Bind ShortId}" />
          <TextBlock
            Grid.Column="2"
            VerticalAlignment="Center"
            Style="{StaticResource RhBodyTextStyle}"
            Foreground="{ThemeResource RhTextSecondaryBrush}"
            Text="{x:Bind Meta}" />
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="RecentTemplate" x:DataType="vm:RecentRow">
        <StackPanel Spacing="6">
          <StackPanel Padding="{StaticResource RhGroupHeadingPadding}" Orientation="Horizontal" Spacing="6">
            <TextBlock
              Style="{StaticResource RhGroupIconStyle}"
              FontFamily="{StaticResource RhIconFilledFontFamily}"
              Foreground="{ThemeResource RhRunningBrush}"
              Text="{StaticResource RhGlyphCheckmarkCircleFilled}" />
            <TextBlock Style="{StaticResource RhGroupHeadingTextStyle}" Text="Recently finished" />
          </StackPanel>
          <Border
            Background="{ThemeResource RhCardBrush}"
            BorderBrush="{ThemeResource RhCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RhCardCornerRadius}">
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Lines, Mode=OneWay}"
              ItemTemplate="{StaticResource RecentLineTemplate}" />
          </Border>
        </StackPanel>
      </DataTemplate>

      <!--
        A copy of WinUI's DefaultMenuFlyoutSubItemStyle with a trailing count before the chevron
        (Meters 4 of 5), taken from the item's Tag.
      -->
      <Style x:Key="RhCountedSubItemStyle" TargetType="MenuFlyoutSubItem">
        <Setter Property="Background" Value="{ThemeResource MenuFlyoutSubItemBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutSubItemBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource MenuFlyoutSubItemBorderThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource MenuFlyoutSubItemForeground}" />
        <Setter Property="Padding" Value="{StaticResource MenuFlyoutItemThemePadding}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="MenuFlyoutSubItem">
              <Grid
                x:Name="LayoutRoot"
                Margin="{StaticResource MenuFlyoutItemMargin}"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundPointerOver}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPointerOver}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronPointerOver}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPointerOver}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundPressed}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPressed}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronPressed}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundPressed}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SubMenuOpened">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundSubMenuOpened}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronSubMenuOpened}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundSubMenuOpened}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutSubItemBackgroundDisabled}" />
                        <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundDisabled}" />
                        <Setter Target="SubItemChevron.Foreground" Value="{ThemeResource MenuFlyoutSubItemChevronDisabled}" />
                        <Setter Target="IconContent.Foreground" Value="{ThemeResource MenuFlyoutSubItemForegroundDisabled}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="CheckPlaceholderStates">
                    <VisualState x:Name="NoPlaceholder" />
                    <VisualState x:Name="CheckPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="IconPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Visibility" Value="Visible" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckAndIconPlaceholder">
                      <VisualState.Setters>
                        <Setter Target="TextBlock.Margin" Value="{ThemeResource MenuFlyoutItemDoublePlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Margin" Value="{ThemeResource MenuFlyoutItemPlaceholderThemeThickness}" />
                        <Setter Target="IconRoot.Visibility" Value="Visible" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="PaddingSizeStates">
                    <VisualState x:Name="DefaultPadding" />
                    <VisualState x:Name="NarrowPadding">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Padding">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox
                    x:Name="IconRoot"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
                  </Viewbox>
                  <TextBlock
                    x:Name="TextBlock"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Foreground="{TemplateBinding Foreground}"
                    Text="{TemplateBinding Text}"
                    TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}" />
                  <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource RhBodyTextStyle}"
                    Foreground="{ThemeResource RhTextSecondaryBrush}"
                    Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    AutomationProperties.AccessibilityView="Raw" />
                  <FontIcon
                    x:Name="SubItemChevron"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource MenuFlyoutSubItemChevron}"
                    Glyph="&#xE974;"
                    MirroredWhenRightToLeft="True" />
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <DataTemplate x:Key="MeterRowTemplate" x:DataType="vm:MeterRowModel">
        <Grid MinHeight="28" Padding="12,0,12,0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="108" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RhBodyTextStyle}"
            FontWeight="SemiBold"
            Text="{x:Bind Label, Mode=OneWay}" />
          <!-- The tooltip covers the row's height, as the 6 px bar alone is hard to hover. -->
          <Grid
            Grid.Column="1"
            Background="Transparent"
            ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
            <local:BulletBar
              Used="{x:Bind Used, Mode=OneWay}"
              Reserved="{x:Bind Reserved, Mode=OneWay}"
              HasReserved="{x:Bind HasReserved, Mode=OneWay}"
              Headroom="{x:Bind Headroom, Mode=OneWay}" />
          </Grid>
          <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="6">
            <local:Sparkline
              VerticalAlignment="Center"
              Samples="{x:Bind Spark, Mode=OneWay}"
              Visibility="{x:Bind HasSpark, Mode=OneWay}" />
            <TextBlock Style="{StaticResource RhBodyTextStyle}" Text="{x:Bind Value, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="DriveRowTemplate" x:DataType="vm:DriveRowModel">
        <Grid MinHeight="28" Padding="12,0,12,0" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="108" />
          </Grid.ColumnDefinitions>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RhBodyTextStyle}"
            FontWeight="SemiBold"
            Text="{x:Bind Label}" />
          <Grid Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The fill and the rest of the track share the bar as star columns. -->
            <Grid
              Height="4"
              VerticalAlignment="Center"
              Background="{ThemeResource RhTrackBrush}"
              CornerRadius="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind local:FlyoutShell.Share(Used), Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind local:FlyoutShell.RestShare(Used), Mode=OneWay}" />
              </Grid.ColumnDefinitions>
              <Border Background="{ThemeResource RhDriveBrush}" CornerRadius="2" />
            </Grid>
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Style="{StaticResource RhCaptionTextStyle}"
              Text="{x:Bind Activity, Mode=OneWay}" />
          </Grid>
          <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource RhBodyTextStyle}"
            Text="{x:Bind Value, Mode=OneWay}" />
        </Grid>
      </DataTemplate>

      <Style x:Key="RhLegendTextStyle" TargetType="TextBlock" BasedOn="{StaticResource RhCaptionTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <local:RowTemplateSelector
        x:Key="RowTemplates"
        BenchmarkHeading="{StaticResource BenchmarkHeadingTemplate}"
        RunningHeading="{StaticResource RunningHeadingTemplate}"
        WaitingHeading="{StaticResource WaitingHeadingTemplate}"
        JobCard="{StaticResource JobCardTemplate}"
        IdleLine="{StaticResource IdleLineTemplate}"
        Nothing="{StaticResource NothingTemplate}"
        Recent="{StaticResource RecentTemplate}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <Border
    BorderBrush="{ThemeResource RhSurfaceEdgeBrush}"
    BorderThickness="1"
    CornerRadius="{StaticResource RhFlyoutCornerRadius}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header: its empty space is the drag handle while pinned. -->
      <Grid
        x:Name="Header"
        Padding="{StaticResource RhHeaderPadding}"
        Background="Transparent"
        SizeChanged="OnHeaderSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The meter mark, drawn from the handoff's tray SVGs (16 x 16 view box). -->
        <Grid Width="16" Height="16" VerticalAlignment="Center">
          <Canvas Visibility="{x:Bind local:FlyoutShell.Shows(Model.Glyph, 'Idle'), Mode=OneWay}">
            <Rectangle Canvas.Left="1" Canvas.Top="14" Width="14" Height="1" Fill="{ThemeResource RhTextBrush}" />
            <Rectangle Canvas.Left="2" Canvas.Top="10" Width="3.5" Height="3.5" RadiusX="1.1" RadiusY="1.1" Stroke="{ThemeResource RhTextBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="6.25" Canvas.Top="10" Width="3.5" Height="3.5" RadiusX="1.1" RadiusY="1.1" Stroke="{ThemeResource RhTextBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="10.5" Canvas.Top="10" Width="3.5" Height="3.5" RadiusX="1.1" RadiusY="1.1" Stroke="{ThemeResource RhTextBrush}" StrokeThickness="1" />
          </Canvas>
          <Canvas Visibility="{x:Bind local:FlyoutShell.Shows(Model.Glyph, 'Busy'), Mode=OneWay}">
            <Rectangle Canvas.Left="1" Canvas.Top="14" Width="14" Height="1" Fill="{ThemeResource RhTextBrush}" />
            <Rectangle Canvas.Left="2" Canvas.Top="7" Width="3.5" Height="6" RadiusX="0.8" RadiusY="0.8" Fill="{ThemeResource RhTextBrush}" />
            <Rectangle Canvas.Left="6.25" Canvas.Top="2" Width="3.5" Height="11" RadiusX="0.8" RadiusY="0.8" Fill="{ThemeResource RhTextBrush}" />
            <Rectangle Canvas.Left="10.5" Canvas.Top="5" Width="3.5" Height="8" RadiusX="0.8" RadiusY="0.8" Fill="{ThemeResource RhTextBrush}" />
          </Canvas>
          <TextBlock
            Style="{StaticResource RhIconFilledTextStyle}"
            Foreground="{ThemeResource RhDangerTextBrush}"
            Text="{StaticResource RhGlyphErrorCircleFilled}"
            Visibility="{x:Bind local:FlyoutShell.Shows(Model.Glyph, 'Error'), Mode=OneWay}" />
        </Grid>

        <TextBlock
          x:Name="SummaryText"
          Grid.Column="1"
          Margin="10,0,10,0"
          VerticalAlignment="Center"
          Style="{StaticResource RhSummaryTextStyle}"
          AutomationProperties.LiveSetting="Polite"
          Text="{x:Bind Model.Summary, Mode=OneWay}" />

        <!-- Pin exists only while Stay open is on; the wrapper's width reveals it. -->
        <Grid
          x:Name="PinWrapper"
          Grid.Column="2"
          Width="0"
          SizeChanged="OnPinWrapperSizeChanged">
          <ToggleButton
            x:Name="PinButton"
            HorizontalAlignment="Left"
            Opacity="0"
            IsTabStop="False"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw"
            AutomationProperties.Name="Pin"
            ToolTipService.ToolTip="Pin"
            Style="{StaticResource RhHeaderToggleStyle}"
            Click="OnPinClick">
            <Grid>
              <TextBlock x:Name="PinIcon" Style="{StaticResource RhButtonIconRegularStyle}" Text="{StaticResource RhGlyphPinRegular}" />
              <TextBlock x:Name="PinnedIcon" Style="{StaticResource RhButtonIconFilledStyle}" Text="{StaticResource RhGlyphPinFilled}" Visibility="Collapsed" />
            </Grid>
          </ToggleButton>
        </Grid>

        <ToggleButton
          x:Name="StayOpenButton"
          Grid.Column="3"
          AutomationProperties.Name="Stay open"
          ToolTipService.ToolTip="Stay open"
          Style="{StaticResource RhHeaderToggleStyle}"
          Click="OnStayOpenClick">
          <Grid>
            <TextBlock x:Name="LockOpenIcon" Style="{StaticResource RhButtonIconRegularStyle}" Text="{StaticResource RhGlyphLockOpenRegular}" />
            <TextBlock x:Name="LockClosedIcon" Style="{StaticResource RhButtonIconFilledStyle}" Text="{StaticResource RhGlyphLockClosedFilled}" Visibility="Collapsed" />
          </Grid>
        </ToggleButton>

        <!-- The pressed look stays on while the menu is open. -->
        <Grid Grid.Column="4" Margin="4,0,0,0">
          <Border
            x:Name="MorePressed"
            Background="{ThemeResource RhPressedBrush}"
            CornerRadius="{StaticResource RhControlCornerRadius}"
            Opacity="0" />
          <Button
            x:Name="MoreButton"
            AutomationProperties.Name="More options"
            ToolTipService.ToolTip="More options"
            Style="{StaticResource RhHeaderButtonStyle}">
            <TextBlock Style="{StaticResource RhButtonIconRegularStyle}" Text="{StaticResource RhGlyphMoreHorizontalRegular}" />
            <Button.Flyout>
              <MenuFlyout
                x:Name="MoreMenu"
                Placement="BottomEdgeAlignedRight"
                Opened="OnMenuOpened"
                Closing="OnMenuClosing"
                Closed="OnMenuClosed">
                <MenuFlyoutSubItem
                  Text="Meters"
                  Tag="{x:Bind Model.MetersCount, Mode=OneWay}"
                  Style="{StaticResource RhCountedSubItemStyle}">
                  <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="{StaticResource RhIconRegularFontFamily}" Glyph="{StaticResource RhGlyphDataBarHorizontalRegular}" />
                  </MenuFlyoutSubItem.Icon>
                  <ToggleMenuFlyoutItem x:Name="CpuItem" Text="CPU" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="RamItem" Text="RAM" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="GpuItem" Text="GPU" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="VramItem" Text="VRAM" Click="OnMeterClick" />
                  <ToggleMenuFlyoutItem x:Name="DrivesItem" Text="Drives" Click="OnMeterClick" />
                  <!-- Indented under Drives, and disabled while Drives is off. -->
                  <ToggleMenuFlyoutItem
                    x:Name="DriveActivityItem"
                    Margin="16,0,0,0"
                    Text="Drive activity"
                    Click="OnMeterClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem
                  Text="Notifications"
                  Tag="{x:Bind Model.NotificationsCount, Mode=OneWay}"
                  Style="{StaticResource RhCountedSubItemStyle}">
                  <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="{StaticResource RhIconRegularFontFamily}" Glyph="{StaticResource RhGlyphAlertRegular}" />
                  </MenuFlyoutSubItem.Icon>
                  <ToggleMenuFlyoutItem x:Name="ServiceStoppedItem" Text="Service stopped" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="RunningLongItem" Text="Running long" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="BenchmarkFinishedItem" Text="Benchmark finished" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="JobFinishedItem" Text="Job finished" Click="OnNotificationClick" />
                  <ToggleMenuFlyoutItem x:Name="KilledOutsideItem" Text="Killed outside the flyout" Click="OnNotificationClick" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open logs" Click="OnOpenLogsClick">
                  <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource RhIconRegularFontFamily}" Glyph="{StaticResource RhGlyphDocumentTextRegular}" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Grid>

      <!--
        Top-aligned, so the panel's height is its content's: stretched, it would fill the
        viewport and report the window's own height back as the height it needs.
      -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel
          x:Name="RowsPanel"
          VerticalAlignment="Top"
          Padding="{StaticResource RhBodyPadding}"
          Opacity="{x:Bind local:FlyoutShell.Dimmed(Model.IsLastKnown), Mode=OneWay}"
          SizeChanged="OnRowsSizeChanged" />
      </ScrollViewer>

      <!-- The Resources card stays docked below the body while the rows scroll. -->
      <Border
        x:Name="ResourcesCard"
        Grid.Row="2"
        Margin="{StaticResource RhResourcesMargin}"
        Background="{ThemeResource RhCardBrush}"
        BorderBrush="{ThemeResource RhCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RhCardCornerRadius}"
        SizeChanged="OnResourcesSizeChanged"
        Visibility="{x:Bind Model.Resources.Visible, Mode=OneWay}">
        <StackPanel>
          <!-- The whole header toggles the card; the chevron stays as its keyboard target. -->
          <Grid
            Height="40"
            Padding="12,0,4,0"
            Background="Transparent"
            ColumnSpacing="8"
            Tapped="OnResourcesHeaderTapped">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource RhBodyTextStyle}"
              FontWeight="SemiBold"
              Text="Resources" />
            <TextBlock
              x:Name="ResourcesSummary"
              Grid.Column="1"
              VerticalAlignment="Center"
              Style="{StaticResource RhDetailTextStyle}"
              Text="{x:Bind Model.Resources.Summary, Mode=OneWay}" />
            <Button
              x:Name="ResourcesToggle"
              Grid.Column="2"
              Style="{StaticResource RhHeaderButtonStyle}"
              AutomationProperties.Name="{x:Bind local:FlyoutShell.ResourcesToggleName(Model.Resources.Expanded), Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind local:FlyoutShell.ResourcesToggleName(Model.Resources.Expanded), Mode=OneWay}"
              Click="OnResourcesToggleClick">
              <Grid>
                <TextBlock
                  Style="{StaticResource RhButtonIconRegularStyle}"
                  Text="{StaticResource RhGlyphChevronUpRegular}"
                  Visibility="{x:Bind local:FlyoutShell.Hides(Model.Resources.Expanded), Mode=OneWay}" />
                <TextBlock
                  Style="{StaticResource RhButtonIconRegularStyle}"
                  Text="{StaticResource RhGlyphChevronDownRegular}"
                  Visibility="{x:Bind Model.Resources.Expanded, Mode=OneWay}" />
              </Grid>
            </Button>
          </Grid>

          <!-- Shown, hidden and animated by the code as the card expands and collapses. -->
          <StackPanel
            x:Name="ResourcesRows"
            Padding="0,0,0,8"
            Spacing="2"
            Visibility="Collapsed">
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Model.Resources.Meters}"
              ItemTemplate="{StaticResource MeterRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border
              Height="1"
              Margin="12,4,12,4"
              Background="{ThemeResource RhSeparatorBrush}"
              Visibility="{x:Bind Model.Resources.ShowSeparator, Mode=OneWay}" />
            <ItemsControl
              IsTabStop="False"
              ItemsSource="{x:Bind Model.Resources.Drives}"
              ItemTemplate="{StaticResource DriveRowTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock
              Padding="12,4,12,4"
              Style="{StaticResource RhDetailTextStyle}"
              TextWrapping="WrapWholeWords"
              Text="All meters are off. Turn them on from ⋯ › Meters."
              Visibility="{x:Bind Model.Resources.AllOff, Mode=OneWay}" />
            <StackPanel
              Padding="12,6,12,0"
              Orientation="Horizontal"
              Spacing="12"
              Visibility="{x:Bind Model.Resources.ShowLegend, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border
                  Width="10"
                  Height="6"
                  VerticalAlignment="Center"
                  Background="{ThemeResource RhAccentBrush}"
                  CornerRadius="1" />
                <TextBlock Style="{StaticResource RhLegendTextStyle}" Text="Used" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border
                  Width="2"
                  Height="10"
                  VerticalAlignment="Center"
                  Background="{ThemeResource RhMarkerBrush}" />
                <TextBlock Style="{StaticResource RhLegendTextStyle}" Text="Reserved" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <local:BulletBar Width="10" Headroom="0" />
                <TextBlock Style="{StaticResource RhLegendTextStyle}" Text="Headroom" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
