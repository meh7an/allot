<?xml version="1.0" encoding="utf-8"?>
<!--
  The 20 x 20 tile at the start of a job row (handoff section 4): the process's initials on a
  tinted square, the real exe icon at 16 px once it is extracted, or the dashed queue position.
-->
<UserControl
  x:Class="ResourcesHelper.Tray.Flyout.ProcessTile"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="{StaticResource RhTileSize}"
  Height="{StaticResource RhTileSize}"
  IsTabStop="False">
  <Grid>
    <Border
      x:Name="Fill"
      Background="{ThemeResource RhTileBackgroundBrush}"
      CornerRadius="{StaticResource RhControlCornerRadius}" />
    <Rectangle
      x:Name="QueuedEdge"
      RadiusX="4"
      RadiusY="4"
      Stroke="{ThemeResource RhQueuedTileBorderBrush}"
      StrokeThickness="1"
      StrokeDashArray="3,3"
      Visibility="Collapsed" />
    <TextBlock
      x:Name="Initials"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Style="{StaticResource RhInitialsTextStyle}"
      Foreground="{ThemeResource RhTextSecondaryBrush}" />
    <Image
      x:Name="Icon"
      Width="{StaticResource RhIconSize}"
      Height="{StaticResource RhIconSize}"
      Stretch="Uniform"
      Visibility="Collapsed" />
  </Grid>
</UserControl>
